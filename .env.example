# CADENCE — .env template (copy to .env, keep .env untracked).
#
# Nothing here is required for the local smoke tests to pass, but the
# production/API integrations read these from the environment when set.

# ---- Cost/carbon integrations ---------------------------------------------

# Electricity Maps API key — used by cadence.carbon.tracker to swap the
# closed-form global-average grid intensity for real-time regional data.
# Get one from https://www.electricitymaps.com/ (free developer tier).
ELECTRICITY_MAPS_API_KEY=

# CodeCarbon output directory. Defaults to CWD when unset.
CODECARBON_OUTPUT_DIR=./experiments/codecarbon

# ---- MLflow ---------------------------------------------------------------

# Tracking URI. Defaults come from configs/*.yaml — override here only when
# pointing at a remote tracking server (e.g. http://mlflow.internal:5000).
# The historical file-store default is deprecated in mlflow >=3; leave this
# unset to use the sqlite backend configured in configs/default.yaml.
# MLFLOW_TRACKING_URI=

# Legacy escape hatch. Only set to true if you must use a file: URI on
# mlflow >=3. See docs/decisions.md D-19.
# MLFLOW_ALLOW_FILE_STORE=true

# ---- API / dashboard secrets ---------------------------------------------

# Only used when cadence/api/server.py's /admin endpoints are enabled.
# Rotate quarterly; treat as production credential.
CADENCE_API_ADMIN_TOKEN=

# ---- Torch behaviour ------------------------------------------------------

# Set to 1 to disable oneDNN warnings on Windows.
TF_ENABLE_ONEDNN_OPTS=0

# Force PPO onto CPU (SB3's own recommendation for MLP policies). Set to
# empty string when you want to force CUDA.
# CUDA_VISIBLE_DEVICES=
